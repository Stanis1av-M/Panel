<Window x:Class="Panel.Views.OrderSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ оформлен" Height="320" Width="420"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PdfButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#00A8FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0097E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#747D8C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#57606F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Width="64" Height="64" CornerRadius="32" Background="#E3FCEF" HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="32" FontWeight="Bold" Foreground="#44BD32"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Row="1" Text="Заказ оформлен!" FontSize="19" FontWeight="Bold"
                   Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,15,0,5"/>

        <TextBlock Grid.Row="2" x:Name="txtOrderInfo" Text="Заказ №0 на сумму 0,00 руб."
                   FontSize="13" Foreground="#747D8C" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="btnDownloadPdf" Content="📄 Скачать чек (PDF)" Style="{StaticResource PdfButtonStyle}"
                    Click="BtnDownloadPdf_Click" Margin="0,0,0,10"/>
        </StackPanel>

        <Button Grid.Row="5" Content="Закрыть" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
    </Grid>
</Window>

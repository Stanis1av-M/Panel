<Window x:Class="Panel.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат с нейросетью" Height="600" Width="550"
        WindowStartupLocation="CenterOwner" Background="#F0F2F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#00A8FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0097E6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#DCDDE1"/>
                    <Setter Property="Foreground" Value="#747D8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Статус подключения (без полей ввода) -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Подключение к нейросети" FontWeight="Bold" FontSize="13" Margin="0,0,0,5" Foreground="#2D3436"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#44BD32" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Встроенный API-ключ успешно подключен" FontSize="12" Foreground="#44BD32" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- История чата -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>

            <ScrollViewer x:Name="ScrollChat" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsChat">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BubbleBackground}" CornerRadius="6" Padding="10,8"
                                    Margin="0,0,0,8" HorizontalAlignment="{Binding BubbleAlignment}" MaxWidth="380">
                                <StackPanel>
                                    <TextBlock Text="{Binding SenderLabel}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding SenderColor}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#2D3436" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Поле ввода -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="txtMessage" Height="35" Padding="8,5" FontSize="13"
                     VerticalContentAlignment="Center" Margin="0,0,10,0" KeyDown="TxtMessage_KeyDown"/>

            <Button Grid.Column="1" x:Name="btnSend" Content="Отправить" Width="100"
                    Style="{StaticResource SendButtonStyle}" Click="BtnSend_Click"/>
        </Grid>
    </Grid>
</Window>
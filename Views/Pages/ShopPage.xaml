<Page x:Class="Panel.Views.Pages.ShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Магазин" Background="#F0F2F5" FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#00A8FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0097E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddToCartButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#4CD137"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44BD32"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#DCDDE1"/>
                    <Setter Property="Foreground" Value="#747D8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Поиск:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" Foreground="#A4B0BE"/>
                    <TextBox x:Name="txtSearch" Width="180" Height="32" Padding="8,5" MaxLength="100"
                             VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Категория:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" Foreground="#A4B0BE"/>
                    <ComboBox x:Name="cmbCategory" Width="160" Height="32" VerticalContentAlignment="Center"
                              SelectionChanged="CmbCategory_SelectionChanged" DisplayMemberPath="Name"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                    <TextBlock Text="Сортировать по:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" Foreground="#A4B0BE"/>
                    <ComboBox x:Name="cmbSort" Width="170" Height="32" VerticalContentAlignment="Center"
                              SelectionChanged="CmbSort_SelectionChanged">
                        <ComboBoxItem Content="Название: А-Я" IsSelected="True"/>
                        <ComboBoxItem Content="Название: Я-А"/>
                        <ComboBoxItem Content="Цена: сначала дешевле"/>
                        <ComboBoxItem Content="Цена: сначала дороже"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,15,8">
                    <CheckBox x:Name="chkOnlyDiscount" Content="Только со скидкой"
                              Checked="ChkOnlyDiscount_Changed" Unchecked="ChkOnlyDiscount_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="btnCart" Content="Корзина" Width="110"
                            Style="{StaticResource CartButtonStyle}" Click="BtnCart_Click"/>
                    <Border Background="#FF4757" CornerRadius="9" MinWidth="18" Height="18" Margin="6,0,0,0" Padding="5,0" VerticalAlignment="Top">
                        <TextBlock x:Name="txtCartCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Витрина товаров -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsProducts">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F5F6FA" CornerRadius="8" Margin="8" Width="210" Padding="10">
                                <StackPanel>
                                    <Border Height="120" CornerRadius="6" Background="White" ClipToBounds="True" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="Нет фото" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#A4B0BE" Visibility="{Binding NoImageVisibility}"/>

                                            <!-- ЗДЕСЬ ИСПРАВЛЕНО: Изменен Stretch на Uniform и добавлен небольшой Margin -->
                                            <Image Source="{Binding ImageSourcePath}" 
                                                   Stretch="Uniform" 
                                                   Margin="5" 
                                                   Visibility="{Binding ImageVisibility}"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#2D3436" TextWrapping="Wrap" Height="36"/>
                                    <TextBlock Text="{Binding Product.Category.Name}" FontSize="11" Foreground="#A4B0BE" Margin="0,2,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PriceText}" FontSize="15" FontWeight="Bold" Foreground="#2D3436"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OldPriceText}" FontSize="11" Foreground="#A4B0BE"
                                                   TextDecorations="Strikethrough" Margin="6,2,0,0"
                                                   Visibility="{Binding DiscountVisibility}"/>
                                        <Border Grid.Column="2" Background="#FF4757" CornerRadius="5" Padding="5,1" HorizontalAlignment="Right"
                                                Visibility="{Binding DiscountVisibility}">
                                            <TextBlock Text="{Binding DiscountText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding StockText}" FontSize="11" Foreground="{Binding StockColor}" Margin="0,0,0,8"/>

                                    <Button Content="В корзину" Style="{StaticResource AddToCartButtonStyle}"
                                            IsEnabled="{Binding InStock}"
                                            Click="BtnAddToCart_Click" Tag="{Binding Product}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
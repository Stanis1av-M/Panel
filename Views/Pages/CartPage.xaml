<Page x:Class="Panel.Views.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина" Background="#F0F2F5" FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#747D8C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#57606F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QtyButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#747D8C"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#57606F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#FF4757"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EA2E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckoutButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#4CD137"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44BD32"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#DCDDE1"/>
                    <Setter Property="Foreground" Value="#747D8C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Назад в магазин" Width="160" Style="{StaticResource BackButtonStyle}" Click="BtnBack_Click"/>
            <TextBlock Grid.Column="1" Text="Корзина" FontSize="20" FontWeight="Bold" Foreground="#2D3436"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>

            <Grid>
                <TextBlock x:Name="txtEmptyCart" Text="Корзина пуста" FontSize="14" Foreground="#A4B0BE"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsCart">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F6FA" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Item.Product.Name}" FontSize="13" FontWeight="SemiBold" Foreground="#2D3436"/>
                                            <TextBlock Text="{Binding PriceText}" FontSize="11" Foreground="#A4B0BE" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <Button Content="-" Style="{StaticResource QtyButtonStyle}" Click="BtnDecrease_Click" Tag="{Binding Item}"/>
                                            <TextBlock Text="{Binding Item.Quantity}" Width="32" TextAlignment="Center"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Button Content="+" Style="{StaticResource QtyButtonStyle}" Click="BtnIncrease_Click" Tag="{Binding Item}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SubtotalText}" FontSize="13" FontWeight="Bold"
                                                   Foreground="#2D3436" VerticalAlignment="Center" Width="90" TextAlignment="Right"/>

                                        <Button Grid.Column="3" Content="X" Style="{StaticResource RemoveButtonStyle}"
                                                Click="BtnRemove_Click" Tag="{Binding Item}" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>

            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Способ доставки:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" Foreground="#A4B0BE"/>
                        <ComboBox x:Name="cmbDelivery" Height="32" DisplayMemberPath="Name" SelectionChanged="OnOrderOptionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Способ оплаты:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" Foreground="#A4B0BE"/>
                        <ComboBox x:Name="cmbPayment" Height="32" DisplayMemberPath="Name" SelectionChanged="OnOrderOptionChanged"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Итого:" FontSize="15" Foreground="#2D3436" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="txtTotal" Text="0 руб." FontSize="18" FontWeight="Bold" Foreground="#2D3436"/>
                </Grid>

                <Button x:Name="btnCheckout" Content="Оформить заказ" Style="{StaticResource CheckoutButtonStyle}" Click="BtnCheckout_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

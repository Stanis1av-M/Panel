<Window x:Class="Panel.Views.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибка" Height="320" Width="480"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5"
        FontFamily="Segoe UI" ResizeMode="NoResize" Topmost="True">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#2F3640"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F4752"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailsButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#747D8C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#57606F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Border Width="44" Height="44" CornerRadius="22" Background="#FFE2E5" Margin="0,0,15,0">
                <TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="#FF4757"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Что-то пошло не так" FontSize="17" FontWeight="Bold" Foreground="#2D3436"/>
                <TextBlock Text="Произошла непредвиденная ошибка" FontSize="12" Foreground="#A4B0BE"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="txtFriendlyMessage" FontSize="13" Foreground="#2D3436"
                   TextWrapping="Wrap" Margin="0,0,0,15"
                   Text="Программа не смогла выполнить операцию. Попробуйте повторить действие ещё раз. Если ошибка повторяется — обратитесь к администратору."/>

        <Expander Grid.Row="2" x:Name="expDetails" Header="Подробности (для администратора)" FontSize="12" Foreground="#747D8C">
            <Border Background="White" CornerRadius="6" Padding="10" Margin="0,8,0,0" BorderBrush="#E1E5EA" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                    <TextBlock x:Name="txtDetails" FontSize="11" Foreground="#57606F" TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
            </Border>
        </Expander>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnCopyDetails" Content="Скопировать подробности" Width="190"
                    HorizontalAlignment="Left" Style="{StaticResource DetailsButtonStyle}" Click="BtnCopyDetails_Click"/>
            <Button Grid.Column="1" Content="Закрыть" Width="110" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
